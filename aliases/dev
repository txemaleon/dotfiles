#!/usr/bin/env zsh

# Dev Shortcuts
alias .='$EDITOR .'

alias bump="nu && cam 'chore: Bump versions' && push"

alias pa="cd $PROJECTS_DIR/personal-agent && ccc"

alias brew=" brew"

# Node Shortcuts
alias y="ni"
alias r="nr "
alias rd="r dev"
alias rj="clear; r jest"
alias rjc="clear; r jest --collectCoverageFrom --coverage"
alias rt="clear; r test"
alias rr="clear; nlx"

# Bun Shortcuts
alias b="bun"
alias bx="bunx"
alias bd="bun dev"

# Python Shortcuts
alias py="uv run python"
alias pyx="uvx"
alias pyl="uv run ruff check"
alias pyfmt="uv run ruff format"
