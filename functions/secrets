#!/usr/bin/env zsh

# macOS Keychain-backed secrets (iCloud Keychain sync, no extra apps).
# Service: dotfiles-secrets · accounts: ntfy-token, resend-api-token, …

_dotfiles_secret_service="dotfiles-secrets"

_dotfiles_secret_parse_file() {
	local file="$1" var="$2"
	[[ -f "$file" ]] || return 1
	local line val
	line=$(grep -E "^export ${var}=" "$file" 2>/dev/null | tail -1) || return 1
	val=${line#export ${var}=}
	val=${val#\"}
	val=${val%\"}
	val=${val#\'}
	val=${val%\'}
	[[ -n "$val" && "$val" != "your-token-here" ]] || return 1
	print -r -- "$val"
}

dotfiles-secret() {
	local cmd="${1:-}"
	shift || true

	case "$cmd" in
	set)
		local name="${1:?Usage: dotfiles-secret set <name> <value>}"
		local value="${2:?Usage: dotfiles-secret set <name> <value>}"
		security add-generic-password -U \
			-s "$_dotfiles_secret_service" \
			-a "$name" \
			-w "$value" \
			-j "dotfiles secret: $name" >/dev/null
		print -u2 "✅ stored $name in Keychain"
		;;
	get)
		local name="${1:?Usage: dotfiles-secret get <name>}"
		_dotfiles_secret_get "$name" || {
			print -u2 "❌ not found: $name"
			return 1
		}
		;;
	import)
		local imported=0 val name key line lspec rest
		local -A _imports=(
			["$DOTFILES/local/ntfy"]="ntfy-token:NTFY_TOKEN"
			["$DOTFILES/local/resend"]="resend-api-token:RESEND_API_TOKEN"
		)
		for file keypair in "${(@kv)_imports}"; do
			name="${keypair%%:*}"
			key="${keypair#*:}"
			val=$(_dotfiles_secret_parse_file "$file" "$key") || continue
			security add-generic-password -U \
				-s "$_dotfiles_secret_service" \
				-a "$name" \
				-w "$val" \
				-j "dotfiles secret: $name" >/dev/null &&
				((imported++)) &&
				print -u2 "✅ stored $name from ${file:t}"
		done
		if [[ -f "$DOTFILES/local/aliases" ]]; then
			line=$(grep -E "^alias tunnel-db-n2c=" "$DOTFILES/local/aliases" 2>/dev/null | tail -1)
			if [[ -n "$line" ]]; then
				rest=${line#*ssh -N -L }
				lspec=${rest%% *}
				ssh_host=${rest##* }
				ssh_host=${ssh_host%%\'*}
				if [[ -n "$lspec" && -n "$ssh_host" ]]; then
					local_port=${lspec%%:*}
					rest=${lspec#*:}
					remote_host=${rest%%:*}
					remote_port=${rest#*:}
					val="${local_port}:${remote_host}:${remote_port}:${ssh_host}"
					security add-generic-password -U \
						-s "$_dotfiles_secret_service" \
						-a tunnel-db-n2c \
						-w "$val" \
						-j "dotfiles secret: tunnel-db-n2c" >/dev/null &&
						((imported++)) &&
						print -u2 "✅ stored tunnel-db-n2c from local/aliases"
				fi
			fi
		fi
		if (( imported == 0 )); then
			print -u2 "⚠️  nothing to import"
			return 1
		fi
		print -u2 "✅ imported $imported secret(s) — reload shell or: source \$DOTFILES/exports/secrets"
		;;
	list)
		print "Known keys (Keychain account names):"
		print "  ntfy-token        → NTFY_TOKEN"
		print "  resend-api-token  → RESEND_API_TOKEN"
		print "  tunnel-db-n2c     → SSH tunnel (local:host:remote:ssh_host)"
		;;
	"" | help | -h | --help)
		cat <<'EOF'
dotfiles-secret — Keychain-backed env secrets (iCloud Keychain sync)

  dotfiles-secret set <name> <value>   Store a secret
  dotfiles-secret get <name>           Print a secret
  dotfiles-secret import             Import legacy local files + tunnel alias
  dotfiles-secret list               List known key names

Tunnel: dotfiles-secret set tunnel-db-n2c '3306:localhost:3306:n2c'
        then run: tunnel-db-n2c

New Mac: enable iCloud Keychain, sign in, wait for sync — or re-run import/set.
EOF
		;;
	*)
		print -u2 "Unknown command: $cmd (try: dotfiles-secret help)"
		return 1
		;;
	esac
}

_dotfiles_secret_get() {
	security find-generic-password -s "$_dotfiles_secret_service" -a "$1" -w 2>/dev/null
}
