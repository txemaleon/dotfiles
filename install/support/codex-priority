#!/usr/bin/env zsh

set -euo pipefail

export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

target_nice="${CODEX_PRIORITY_NICE:--5}"
codex_app="/Applications/ChatGPT.app"

[[ -d "$codex_app" ]] || exit 0

collect_codex_pids() {
	ps -axo pid=,nice=,args= | awk -v prefix="$codex_app/" -v target="$target_nice" '
		{
			pid = $1
			nice = $2
			$1 = $2 = ""
			sub(/^[[:space:]]+/, "")
			if (index($0, prefix) == 1 && nice != target) print pid
		}
	'
}

pids=("${(@f)$(collect_codex_pids)}")
pids=("${(@M)pids:#<->}")
[[ "${#pids[@]}" -gt 0 ]] || exit 0

if [[ "$(id -u)" -ne 0 ]]; then
	if sudo -n true 2>/dev/null; then
		exec sudo -n "$0" "$@"
	fi

	echo "codex-priority requires root to set negative nice values." >&2
	exit 1
fi

# A process may exit between the snapshot and renice; that race is harmless.
renice "$target_nice" -p "${pids[@]}" >/dev/null 2>&1 || true
