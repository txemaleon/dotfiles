#!/usr/bin/env zsh

# API tokens from macOS Keychain (syncs via iCloud Keychain when enabled).
# Manage with: dotfiles-secret set|get|import|list

_dotfiles_secret_get() {
	security find-generic-password -s "dotfiles-secrets" -a "$1" -w 2>/dev/null
}

_token="$(_dotfiles_secret_get ntfy-token)"
[[ -n "$_token" ]] && export NTFY_TOKEN="$_token"
_token="$(_dotfiles_secret_get resend-api-token)"
[[ -n "$_token" ]] && export RESEND_API_TOKEN="$_token"

unset -f _dotfiles_secret_get
unset _token
